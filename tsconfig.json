{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  // The islands are browser code with a different JSX runtime and DOM lib.
  // They have their own tsconfig.islands.json.
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/islands/**"]
}
