{
  "name": "buc-alumni-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:islands": "node scripts/build-islands.mjs",
    "dev": "npm run build:islands -- --dev && npm run db:local && wrangler dev",
    "build": "npm run build:islands",
    "deploy": "npm run build:islands && wrangler deploy",
    "db:local": "wrangler d1 migrations apply buc_alumni --local",
    "db:remote": "wrangler d1 migrations apply buc_alumni --remote",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.islands.json",
    "check:visibility": "node scripts/check-visibility.mjs",
    "check:visibility:live": "node scripts/check-visibility.mjs https://buc-alumni-portal.buc-alumni-portal.workers.dev --remote"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "gsap": "^3.15.0",
    "hono": "^4.6.14",
    "pdf-lib": "^1.17.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "esbuild": "^0.28.1",
    "page-flip": "^2.0.7",
    "preact": "^10.29.8",
    "typescript": "^5.7.2",
    "wrangler": "^4.118.0"
  }
}
